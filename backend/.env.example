# ---------------------------------------------------------------------------
# Car Rental Management System - Backend Environment Configuration
# Copy this file to .env and fill in real values before starting the server.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/car_rental?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS (frontend URL(s))
CLIENT_ORIGIN="http://localhost:5173"

# JWT secrets - MUST be long, random, unique strings in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-me-access-secret-change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret-change-me-refresh-secret"

# Token lifetimes (jsonwebtoken "zeit/ms" style strings)
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Password reset token lifetime (minutes)
RESET_TOKEN_EXPIRES_MIN=30

# bcrypt salt rounds
BCRYPT_SALT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Request body size limit
JSON_BODY_LIMIT="1mb"

# Logging level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Uploaded file storage (local disk path, served statically in dev)
UPLOAD_DIR="uploads"
