// ---------------------------------------------------------------------------
// Car Rental Management System - Prisma Schema
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================== ENUMS ====================================

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum TransmissionType {
  AUTOMATIC
  MANUAL
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum RentalStatus {
  PENDING
  ACTIVE
  COMPLETED
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentType {
  PAYMENT
  DEPOSIT
  DEPOSIT_REFUND
  REFUND
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ExpenseCategory {
  MAINTENANCE
  REPAIRS
  FUEL
  INSURANCE
  REGISTRATION
  CLEANING
  SALARIES
  RENT
  UTILITIES
  MARKETING
  OPERATIONAL
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionType {
  PRE_RENTAL
  POST_RENTAL
}

enum ConditionRating {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

enum DamageStatus {
  REPORTED
  UNDER_REVIEW
  REPAIR_SCHEDULED
  REPAIRED
  CLOSED
}

enum NotificationType {
  BOOKING_PENDING
  RENTAL_OVERDUE
  UPCOMING_RETURN
  UNPAID_BALANCE
  INSURANCE_EXPIRING
  REGISTRATION_EXPIRING
  MAINTENANCE_DUE
  VEHICLE_UNAVAILABLE
  DAMAGE_REPORTED
  SYSTEM
}

// =============================== MODELS ====================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role      @default(EMPLOYEE)
  isActive     Boolean   @default(true)
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  createdBookings     Booking[]             @relation("BookingCreatedBy")
  checkedOutRentals   Rental[]              @relation("RentalCheckedOutBy")
  checkedInRentals    Rental[]              @relation("RentalCheckedInBy")
  receivedPayments    Payment[]             @relation("PaymentReceivedBy")
  createdExpenses     Expense[]             @relation("ExpenseCreatedBy")
  inspections         VehicleInspection[]   @relation("InspectionInspector")
  activityLogs        ActivityLog[]
  notifications       Notification[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  replacedByToken String?
  createdByIp     String?

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Customer {
  id                        String    @id @default(uuid())
  firstName                 String
  lastName                  String
  email                     String    @unique
  phone                     String
  address                   String?
  city                      String?
  country                   String?
  dateOfBirth               DateTime?
  driverLicenseNumber       String?
  driverLicenseIssueCountry String?
  driverLicenseExpiry       DateTime?
  idType                    String?
  idNumber                  String?
  emergencyContactName      String?
  emergencyContactPhone     String?
  notes                     String?
  isActive                  Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  bookings     Booking[]
  rentals      Rental[]
  payments     Payment[]
  damageReports DamageReport[]

  @@index([email])
  @@index([phone])
  @@index([driverLicenseNumber])
  @@map("customers")
}

model VehicleCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles Vehicle[]
  bookings Booking[]

  @@map("vehicle_categories")
}

model Vehicle {
  id                 String            @id @default(uuid())
  plateNumber        String            @unique
  vin                String            @unique
  brand              String
  model               String
  year               Int
  categoryId         String
  category           VehicleCategory   @relation(fields: [categoryId], references: [id])
  transmission       TransmissionType
  fuelType           FuelType
  seats              Int
  doors              Int
  color              String
  mileage            Int               @default(0)
  dailyRate          Decimal           @db.Decimal(10, 2)
  weeklyRate         Decimal?          @db.Decimal(10, 2)
  securityDeposit    Decimal           @db.Decimal(10, 2)
  status             VehicleStatus     @default(AVAILABLE)
  currentLocation    String?
  insuranceExpiry    DateTime?
  registrationExpiry DateTime?
  lastServiceDate    DateTime?
  nextServiceDate    DateTime?
  notes              String?
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  images             VehicleImage[]
  bookings           Booking[]
  rentals            Rental[]
  expenses           Expense[]
  maintenanceRecords MaintenanceRecord[]
  inspections        VehicleInspection[]
  damageReports      DamageReport[]

  @@index([plateNumber])
  @@index([vin])
  @@index([status])
  @@index([categoryId])
  @@map("vehicles")
}

model VehicleImage {
  id        String   @id @default(uuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@map("vehicle_images")
}

model Booking {
  id               String        @id @default(uuid())
  bookingNumber    String        @unique
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id])
  vehicleId        String
  vehicle          Vehicle       @relation(fields: [vehicleId], references: [id])
  categoryId       String?
  category         VehicleCategory? @relation(fields: [categoryId], references: [id])
  pickupAt         DateTime
  returnAt         DateTime
  pickupLocation   String
  returnLocation   String
  dailyRate        Decimal       @db.Decimal(10, 2)
  rentalDays       Int
  subtotal         Decimal       @db.Decimal(10, 2)
  tax              Decimal       @db.Decimal(10, 2) @default(0)
  discount         Decimal       @db.Decimal(10, 2) @default(0)
  additionalFees   Decimal       @db.Decimal(10, 2) @default(0)
  securityDeposit  Decimal       @db.Decimal(10, 2) @default(0)
  totalAmount      Decimal       @db.Decimal(10, 2)
  amountPaid       Decimal       @db.Decimal(10, 2) @default(0)
  remainingBalance Decimal       @db.Decimal(10, 2) @default(0)
  notes            String?
  status           BookingStatus @default(PENDING)
  createdById      String
  createdBy        User          @relation("BookingCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  rental   Rental?
  payments Payment[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([pickupAt])
  @@index([returnAt])
  @@index([vehicleId, status, pickupAt, returnAt])
  @@map("bookings")
}

model Rental {
  id                  String        @id @default(uuid())
  rentalNumber        String        @unique
  bookingId           String?       @unique
  booking             Booking?      @relation(fields: [bookingId], references: [id])
  customerId          String
  customer            Customer      @relation(fields: [customerId], references: [id])
  vehicleId           String
  vehicle             Vehicle       @relation(fields: [vehicleId], references: [id])
  checkoutAt          DateTime
  expectedReturnAt    DateTime
  actualReturnAt      DateTime?
  startMileage        Int
  returnMileage       Int?
  startFuelLevel      Int
  returnFuelLevel     Int?
  initialCondition    Json?
  returnedCondition   Json?
  dailyRate           Decimal       @db.Decimal(10, 2)
  securityDeposit     Decimal       @db.Decimal(10, 2) @default(0)
  additionalCharges   Decimal       @db.Decimal(10, 2) @default(0)
  lateFee             Decimal       @db.Decimal(10, 2) @default(0)
  mileageFee          Decimal       @db.Decimal(10, 2) @default(0)
  fuelFee             Decimal       @db.Decimal(10, 2) @default(0)
  damageFee           Decimal       @db.Decimal(10, 2) @default(0)
  discount            Decimal       @db.Decimal(10, 2) @default(0)
  tax                 Decimal       @db.Decimal(10, 2) @default(0)
  finalAmount         Decimal       @db.Decimal(10, 2) @default(0)
  paymentStatus       PaymentStatus @default(PENDING)
  status              RentalStatus  @default(PENDING)
  checkedOutById      String?
  checkedOutBy        User?         @relation("RentalCheckedOutBy", fields: [checkedOutById], references: [id])
  checkedInById       String?
  checkedInBy         User?         @relation("RentalCheckedInBy", fields: [checkedInById], references: [id])
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  payments      Payment[]
  inspections   VehicleInspection[]
  damageReports DamageReport[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([expectedReturnAt])
  @@index([vehicleId, status, checkoutAt, expectedReturnAt])
  @@map("rentals")
}

model Payment {
  id            String        @id @default(uuid())
  paymentNumber String        @unique
  bookingId     String?
  booking       Booking?      @relation(fields: [bookingId], references: [id])
  rentalId      String?
  rental        Rental?       @relation(fields: [rentalId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  type          PaymentType   @default(PAYMENT)
  status        PaymentStatus @default(COMPLETED)
  reference     String?
  notes         String?
  receivedById  String
  receivedBy    User          @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  createdAt     DateTime      @default(now())

  transaction Transaction?

  @@index([bookingId])
  @@index([rentalId])
  @@index([customerId])
  @@index([status])
  @@map("payments")
}

model Transaction {
  id              String          @id @default(uuid())
  type            TransactionType
  category        String
  amount          Decimal         @db.Decimal(10, 2)
  description     String?
  occurredAt      DateTime        @default(now())
  relatedPaymentId String?        @unique
  relatedPayment  Payment?        @relation(fields: [relatedPaymentId], references: [id])
  relatedExpenseId String?        @unique
  relatedExpense  Expense?        @relation(fields: [relatedExpenseId], references: [id])
  createdAt       DateTime        @default(now())

  @@index([type])
  @@index([occurredAt])
  @@map("transactions")
}

model Expense {
  id          String          @id @default(uuid())
  date        DateTime
  amount      Decimal         @db.Decimal(10, 2)
  category    ExpenseCategory
  description String
  vendor      String?
  vehicleId   String?
  vehicle     Vehicle?        @relation(fields: [vehicleId], references: [id])
  receiptRef  String?
  isArchived  Boolean         @default(false)
  createdById String
  createdBy   User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  transaction Transaction?

  @@index([category])
  @@index([date])
  @@index([vehicleId])
  @@map("expenses")
}

model MaintenanceRecord {
  id               String             @id @default(uuid())
  vehicleId        String
  vehicle          Vehicle            @relation(fields: [vehicleId], references: [id])
  serviceType      String
  serviceDate      DateTime
  mileage          Int
  cost             Decimal            @db.Decimal(10, 2) @default(0)
  provider         String?
  description      String?
  nextServiceDate  DateTime?
  nextServiceMileage Int?
  status           MaintenanceStatus  @default(SCHEDULED)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([vehicleId])
  @@index([status])
  @@index([serviceDate])
  @@map("maintenance_records")
}

model VehicleInspection {
  id                  String          @id @default(uuid())
  vehicleId           String
  vehicle             Vehicle         @relation(fields: [vehicleId], references: [id])
  rentalId            String?
  rental              Rental?         @relation(fields: [rentalId], references: [id])
  type                InspectionType
  inspectionDate      DateTime        @default(now())
  inspectorId         String
  inspector           User            @relation("InspectionInspector", fields: [inspectorId], references: [id])
  mileage             Int
  fuelLevel           Int
  cleanliness         ConditionRating
  exteriorCondition   ConditionRating
  interiorCondition   ConditionRating
  tireCondition       ConditionRating
  windshieldCondition ConditionRating
  notes               String?
  images              Json?
  createdAt           DateTime        @default(now())

  @@index([vehicleId])
  @@index([rentalId])
  @@map("vehicle_inspections")
}

model DamageReport {
  id                  String       @id @default(uuid())
  vehicleId           String
  vehicle             Vehicle      @relation(fields: [vehicleId], references: [id])
  rentalId            String?
  rental              Rental?      @relation(fields: [rentalId], references: [id])
  customerId          String?
  customer            Customer?    @relation(fields: [customerId], references: [id])
  description         String
  location            String
  photos              Json?
  dateReported         DateTime     @default(now())
  estimatedRepairCost Decimal?     @db.Decimal(10, 2)
  actualRepairCost    Decimal?     @db.Decimal(10, 2)
  customerResponsible Boolean      @default(false)
  insuranceInvolved   Boolean      @default(false)
  status              DamageStatus @default(REPORTED)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([vehicleId])
  @@index([rentalId])
  @@index([status])
  @@map("damage_reports")
}

model Notification {
  id               String           @id @default(uuid())
  userId           String?
  user             User?            @relation(fields: [userId], references: [id])
  type             NotificationType
  title            String
  message          String
  relatedEntityType String?
  relatedEntityId  String?
  isRead           Boolean          @default(false)
  createdAt        DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@map("activity_logs")
}

model CompanySettings {
  id                     String   @id @default(uuid())
  companyName            String   @default("My Car Rental Company")
  logoUrl                String?
  address                String?
  phone                  String?
  email                  String?
  website                String?
  taxNumber              String?
  currency               String   @default("USD")
  taxPercentage          Decimal  @db.Decimal(5, 2) @default(0)
  defaultSecurityDeposit Decimal  @db.Decimal(10, 2) @default(0)
  lateFeePerDay          Decimal  @db.Decimal(10, 2) @default(0)
  mileageFeePerUnit      Decimal  @db.Decimal(10, 2) @default(0)
  freeMileagePerDay      Int      @default(0)
  fuelChargePerUnit      Decimal  @db.Decimal(10, 2) @default(0)
  cancellationPolicy     String?
  rentalTerms            String?
  invoiceFooter          String?
  updatedAt              DateTime @updatedAt

  @@map("company_settings")
}
